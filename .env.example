BOT_TOKEN=replace_with_telegram_bot_token
AI_API_TOKEN=replace_with_deepseek_api_key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_PARTICIPATION_MODEL=deepseek-v4-flash
AI_RESEARCH_MODEL=deepseek-v4-flash
AI_OBSERVER_MODEL=deepseek-v4-flash
AI_SUMMARY_MODEL=deepseek-v4-flash
AI_THINKING_ENABLED=false
AI_OBSERVER_ENABLED=true
AI_RECENT_MESSAGES_LIMIT=30
AI_SUMMARY_ENABLED=true
AI_SUMMARY_BATCH_SIZE=8
AI_SUMMARY_MAX_BATCH_MESSAGES=60
AI_SUMMARY_MAX_CHARS=2000
AI_SUMMARY_RETRY_COOLDOWN_SECONDS=900
# Number of compact participant profiles given to the actor for one reply.
AI_MEMORY_MAX_PROFILES=3
# Facts retained from each selected profile in actor context.
AI_MEMORY_MAX_FACTS_PER_PROFILE=4
# Participation sees this many recently active participant identities when resolving mentions.
AI_MEMORY_PARTICIPANT_CANDIDATES_LIMIT=40
AI_BRIEF_MAX_TOKENS=160
AI_NORMAL_MAX_TOKENS=500
AI_DETAILED_MAX_TOKENS=1000
AI_RESEARCH_ENABLED=true
RESEARCH_CACHE_TTL_SECONDS=21600
RESEARCH_TIMEOUT_SECONDS=8
RESEARCH_MAX_FACTS=6
SEARXNG_SECRET=replace_with_a_long_random_value
TELEGRAM_DROP_PENDING_UPDATES=true
# Numeric user ID allowed to unlock individual chats with /start; 0 disables the gate.
TELEGRAM_ADMIN_ID=0
TELEGRAM_API_MODE=cloud
# Compose activates the matching profile automatically; "cloud" has no extra service.
COMPOSE_PROFILES=${TELEGRAM_API_MODE}
TELEGRAM_API_BASE_URL=
TELEGRAM_API_REQUEST_TIMEOUT_SECONDS=300
TELEGRAM_UPLOAD_CHUNK_SIZE=1048576
# Required only when TELEGRAM_API_MODE=local; obtain at https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
MEDIA_TEMP_DIR=data/media
MEDIA_MAX_BYTES=48000000
MEDIA_MAX_DURATION_SECONDS=600
MEDIA_MAX_CONCURRENT_DOWNLOADS=2
# A post may be sent as several Telegram albums of up to 10 media each.
MEDIA_MAX_ITEMS=50
MEDIA_PROXY_URL=
# Optional legacy combined Netscape cookie file. Platform-specific files below win.
MEDIA_COOKIES_FILE=
# Paths inside the Docker container. Compose mounts files from ./cookies/ read-only.
MEDIA_YOUTUBE_COOKIES_FILE=/run/secrets/ch00chka/youtube-cookies.txt
MEDIA_TIKTOK_COOKIES_FILE=/run/secrets/ch00chka/tiktok-cookies.txt
MEDIA_INSTAGRAM_COOKIES_FILE=/run/secrets/ch00chka/instagram-cookies.txt
# Writable copies used by yt-dlp. They persist in bot-data and are initialized
# from the files above when absent. Set RESET=true for one restart after replacing
# an exported cookie file, then change it back to false.
MEDIA_COOKIE_JAR_DIR=data/cookies
MEDIA_COOKIE_JAR_RESET=false
LOCAL_MEDIA_MAX_BYTES=1900000000
LOCAL_MEDIA_MAX_DURATION_SECONDS=14400
DB_PATH=AI_module/bot_talker_memory.db
